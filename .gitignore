# Personal presentation notes. Stays on the local machine, never committed.
PRESENTATION_GUIDE.md

# ---------------------------------------------------------------------------
# Python backend
# ---------------------------------------------------------------------------
python-backend/.venv/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.env

# Generated log files are runtime output, not source. The logs/ directory
# itself is kept (see logs/.gitkeep) so the backend can write into it on a
# fresh clone without any extra setup step.
*.log
python-backend/logs/*.log
python-backend/logs/*.log.*

